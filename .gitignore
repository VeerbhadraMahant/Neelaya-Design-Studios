# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Env files (never commit real secrets/config — .env.example files are tracked)
.env
.env.local
.env.*.local

# Backend runtime data (contact/newsletter submissions — local persistence only)
backend/data/*.json
!backend/data/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / tool-local state (not part of the project)
.vscode/
.claude/
.idea/

# OS junk
.DS_Store
Thumbs.db
Desktop.ini
