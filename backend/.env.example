# Copy this file to .env and adjust as needed.

# Port the API server listens on
PORT=4000

# Comma-separated list of origins allowed to call this API in production.
# In development, http://localhost:5173 (the Vite dev server) is always allowed.
CORS_ORIGIN=http://localhost:5173

# --- Optional: real email delivery (not required to run the demo) ---
# Fill these in and uncomment the nodemailer code in src/lib/mailer.js
# to have contact/newsletter submissions emailed to the studio instead of
# (or in addition to) being saved to backend/data/*.json.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# STUDIO_NOTIFY_EMAIL=studio@neelayadesign.com
